theme = GitHub Dark Dimmed
# Installed by the Brewfile (font-jetbrains-mono-nerd-font). Needed for the
# oh-my-posh theme and Claude statusline glyphs; the Mono variant keeps those
# glyphs single-width so they do not shift the rest of the line.
font-family = JetBrainsMono Nerd Font Mono
font-size = 14
shell-integration-features = ssh-terminfo, ssh-env
