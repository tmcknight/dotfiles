# Dev machine extras, installed on top of Brewfile.base. Anything both
# profiles need belongs there, not here.

# Taps
tap "stablyai/orca"
tap "typewhisper/tap"

# CLI Tools
brew "azure-dev"
brew "doctl"
# The .NET SDK. This is the formula, not the `dotnet-sdk` cask, because the
# `powershell` formula depends on it and the two fight over
# /opt/homebrew/bin/dotnet -- whichever loses leaves `brew link` failing on
# every bundle. Rider does not find this layout on its own: point its SDK path
# at /opt/homebrew/opt/dotnet/libexec.
brew "dotnet"
brew "ffmpeg"
brew "lefthook"
brew "libpq"
brew "msedit"
brew "powershell"
brew "s3cmd"
brew "shellcheck"
brew "uv"

# Fonts
cask "font-meslo-lg-nerd-font"

# Applications
cask "copilot-cli"
cask "firefox"
cask "ghostty"
cask "github"
cask "gitify"
cask "google-chrome"
cask "iina"
cask "localsend"
cask "microsoft-teams"
cask "nordvpn"
cask "notion"
cask "notion-cli"
cask "orbstack"
cask "rider"
cask "visual-studio-code"
cask "whatsapp"
cask "stablyai/orca/orca"
cask "typewhisper/tap/typewhisper"
