{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "diamond",
          "foreground": "p:fgb",
          "background": "p:gray",
          "template": " {{ .UserName }} ",
          "leading_diamond": "",
          "trailing_diamond": ""
        },
        {
          "type": "path",
          "style": "powerline",
          "foreground": "p:fgb",
          "background": "p:blue",
          "template": "   {{ .Path }} ",
          "powerline_symbol": "",
          "options": {
            "style": "folder",
            "home_icon": "~",
            "folder_separator_icon": "  "
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "foreground": "p:fgb",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:ink{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:fgb{{ end }}",
            "{{ if gt .Ahead 0 }}p:ink{{ end }}"
          ],
          "background": "p:green",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:red{{ end }}",
            "{{ if gt .Ahead 0 }}p:blueb{{ end }}",
            "{{ if gt .Behind 0 }}p:purple{{ end }}"
          ],
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "powerline_symbol": "",
          "trailing_diamond": "",
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "branch_template": "{{ trunc 25 .Branch }}"
          }
        },
        {
          "type": "node",
          "style": "powerline",
          "foreground": "p:fgb",
          "background": "p:green",
          "template": "  {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "powerline_symbol": "",
          "options": {
            "fetch_version": true
          }
        },
        {
          "type": "go",
          "style": "powerline",
          "foreground": "p:fgb",
          "background": "p:blue",
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "powerline_symbol": "",
          "options": {
            "fetch_version": true
          }
        },
        {
          "type": "julia",
          "style": "powerline",
          "foreground": "p:fgb",
          "background": "p:navy",
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "powerline_symbol": "",
          "options": {
            "fetch_version": true
          }
        },
        {
          "type": "python",
          "style": "powerline",
          "foreground": "p:ink",
          "background": "p:yellow",
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "powerline_symbol": "",
          "options": {
            "display_mode": "files",
            "fetch_virtual_env": false
          }
        },
        {
          "type": "ruby",
          "style": "powerline",
          "foreground": "p:fgb",
          "background": "p:red",
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "powerline_symbol": "",
          "options": {
            "display_mode": "files",
            "fetch_version": true
          }
        },
        {
          "type": "azfunc",
          "style": "powerline",
          "foreground": "p:fgb",
          "background": "p:orange",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "powerline_symbol": "",
          "options": {
            "display_mode": "files",
            "fetch_version": false
          }
        },
        {
          "type": "aws",
          "style": "powerline",
          "foreground": "p:fgb",
          "background_templates": [
            "{{if contains \"default\" .Profile}}p:orange{{end}}",
            "{{if contains \"jan\" .Profile}}p:red{{end}}"
          ],
          "template": "  {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
          "powerline_symbol": "",
          "options": {
            "display_default": false
          }
        },
        {
          "type": "root",
          "style": "powerline",
          "foreground": "p:ink",
          "background": "p:yellow",
          "template": "  ",
          "powerline_symbol": ""
        },
        {
          "type": "status",
          "style": "powerline",
          "foreground": "p:fgb",
          "background": "p:red",
          "template": " ",
          "powerline_symbol": ""
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "shell",
          "style": "plain",
          "foreground": "p:fgb",
          "background": "p:gray",
          "template": "<p:gray,transparent></>  {{ .Name }} <transparent,p:gray></>"
        },
        {
          "type": "ytm",
          "style": "powerline",
          "foreground": "p:fgb",
          "background": "p:gray",
          "template": "  {{ .Icon }}{{ if ne .Status \"stopped\" }}{{ .Artist }} - {{ .Track }}{{ end }} ",
          "powerline_symbol": "",
          "invert_powerline": true,
          "options": {
            "playing_icon": " ",
            "paused_icon": " "
          }
        },
        {
          "type": "time",
          "style": "diamond",
          "foreground": "p:fgb",
          "background": "p:gray",
          "template": " {{ .CurrentDate | date .Format }} ",
          "leading_diamond": "",
          "trailing_diamond": "",
          "invert_powerline": true
        }
      ]
    }
  ],
  "palette": {
    "bg": "#22272e",
    "fg": "#adbac7",
    "fgb": "#cdd9e5",
    "fgm": "#768390",
    "fgs": "#545d68",
    "ink": "#1c2128",
    "border": "#444c56",
    "gray": "#636e7b",
    "blue": "#316dca",
    "navy": "#1b4b91",
    "green": "#347d39",
    "yellow": "#966600",
    "orange": "#ae5622",
    "red": "#c93c37",
    "purple": "#8256d0",
    "pink": "#ae4c82",
    "cyan": "#1b7f8a",
    "blueb": "#6cb6ff",
    "greenb": "#6bc46d",
    "yellowb": "#daaa3f",
    "orangeb": "#e0823d",
    "redb": "#ff938a",
    "purpleb": "#dcbdfb"
  }
}